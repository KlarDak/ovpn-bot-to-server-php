# Токен для работы Telegram-бота
TOKEN=

# Адрес директории для временного хранения конфиг-файлов пользователя
CONFIGS_DIR=

# Хост базы данных
DB_HOSTNAME=
# Порт базы данных
DB_PORT=
# Имя пользователя базы данных
DB_USERNAME=
# Пароль пользователя базы данных
DB_PASSWORD=
# Имя базы данных
DB_DATABASE=

# Блок с адресами, индексами и секретными ключами дочерних серверов.
# Важно: индекс и секретный ключ здесь и у дочернего сервера должны быть ОДИНАКОВЫМИ.
# Каждый сервер имеют свой индекс и секретный ключ.
# Каждый блок различается лишь первыми двумя буквами. Перед использованием, замените [TEMP] на иное буквенное обозначение.

# Адрес дочернего сервера
[TEMP]_SERVER_ADDRESS=
# Индекс дочернего сервера
[TEMP]_SERVER_INDEX=
# Секретный ключ дочернего сервера
[TEMP]_SECRET_KEY=

# Индекс сервера (используется для общения серверов друг с другом)
SUB_INDEX=

# Хост базы данных Redis
REDIS_HOSTNAME=
# Порт базы данных Redis
REDIS_PORT=